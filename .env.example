# Everything is optional except for /ask. Without the /ask settings the atlas
# serves every view and /ask answers 503.

# --- /ask: which model answers ---------------------------------------------
# The deployer chooses; a visitor never does. Before trusting a new model, run
#   atlas eval-ask
# which puts fixed questions about the validation genes to it and checks the answers
# against the store.
#
# Anthropic (the default): the cheapest way to run Claude, with prompt caching.
# It reads ANTHROPIC_API_KEY, not ATLAS_LLM_API_KEY.
ANTHROPIC_API_KEY=
# ATLAS_LLM_MODEL=claude-haiku-5-5
#
# OpenRouter: any model it serves.
# ATLAS_LLM=openrouter
# ATLAS_LLM_API_KEY=sk-or-...
# ATLAS_LLM_MODEL=qwen/qwen3-235b-a22b
#
# Ollama: a model on your own hardware; questions stay on your network while the model
# runs locally (not with Ollama's cloud models or a remote base URL). Ollama's default
# context is smaller than the atlas's ~9k-token schema and its OpenAI endpoint cannot
# raise it per request, so start the Ollama server with OLLAMA_CONTEXT_LENGTH=32768 or
# the prompt is cut and answers go wrong without an error. Pick a model with tool calling.
# ATLAS_LLM=ollama
# ATLAS_LLM_MODEL=qwen3:14b
# ATLAS_LLM_BASE_URL=http://ollama:11434/v1   # Ollama in the same Docker network
#
# Anything else that speaks OpenAI chat completions (vLLM, LM Studio, OpenAI):
# ATLAS_LLM=openai-compatible
# ATLAS_LLM_BASE_URL=https://llm.example.org/v1
# ATLAS_LLM_API_KEY=
# ATLAS_LLM_MODEL=
# ATLAS_LLM_MAX_TOKENS=4096   # optional; non-Anthropic backends only
#
# The privacy page says where a question goes. Only a loopback address is described as
# "a model run by the operator of this site"; anything else is named by host. If you know
# better (a GPU box you run behind a service name), say it in your own words:
# ATLAS_LLM_LABEL=a model on the lab's own GPU server
#
# What a question costs depends on the model, so the allowances are yours to set.
# ATLAS_ASK_ANON_PER_HOUR=5
# ATLAS_ASK_SIGNED_IN_PER_DAY=20
# ATLAS_ASK_GLOBAL_PER_DAY=500

# --- /ask: who may ask ------------------------------------------------------
# Any long random string: signs the session cookie and hashes IPs for counting.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_SECRET=
# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ORCID sign-in (optional; raises the allowance from the hourly to the daily one).
# Register a public API client at https://orcid.org/developer-tools with the
# redirect URI <ATLAS_PUBLIC_URL>/api/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# ORCID_BASE=https://sandbox.orcid.org
# The address visitors use, with no trailing slash, e.g. https://atlas.example.org
ATLAS_PUBLIC_URL=
# Set to off to disable every /ask limit (local development only).
# ATLAS_ASK_LIMITS=off

# --- who runs this instance (shown on the privacy page) ---------------------
ATLAS_OPERATOR=
ATLAS_CONTACT=
# Extra footer links an institution requires, as JSON:
# ATLAS_FOOTER_LINKS=[{"label": "Site policies", "url": "https://example.org/policies"}]

# --- behind a reverse proxy --------------------------------------------------
# The proxy's address or subnet, so the visitor's IP is the one counted.
# FORWARDED_ALLOW_IPS=172.16.50.0/24
